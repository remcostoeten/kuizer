{
	"oxlint.enable": true,
	"oxlint.run": "onType",
	"oxlint.fix": true,
	"oxlint.advanced.languageServer": true,
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxfmt",
		"editor.formatOnSave": true,
		"editor.tabSize": 4,
		"editor.insertSpaces": false
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxfmt",
		"editor.formatOnSave": true,
		"editor.tabSize": 4,
		"editor.insertSpaces": false
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxfmt",
		"editor.formatOnSave": true,
		"editor.tabSize": 4,
		"editor.insertSpaces": false
	},
	"editor.codeActionsOnSave": {
		"source.organizeImports": "explicit"
	},
	"typescript.updateImportsOnFileMove.enabled": "always",
	"typescript.importModuleSpecifier": "relative",
	"typescript.preferences.importModuleSpecifierEnding": "relative"
}
