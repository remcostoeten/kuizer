{
  "name": "kuizer-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "brand:build": "bun scripts/build-brand.mjs",
    "dev": "bun scripts/serve.ts dev",
    "build": "bun run check:links && bun --bun next build",
    "start": "bun scripts/serve.ts start",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun --bun fumadocs-mdx && bun --bun next typegen && tsc --noEmit",
    "postinstall": "bun --bun fumadocs-mdx",
    "test": "bun test",
    "check:links": "bun scripts/check-links.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "1.61.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.3"
}
