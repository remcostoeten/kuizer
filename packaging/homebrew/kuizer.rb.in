class Kuizer < Formula
  desc "Keyboard-driven disk cleanup for developers"
  homepage "https://kuizer.app"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/remcostoeten/kuizer/releases/download/v@VERSION@/kuizer-aarch64-apple-darwin.tar.xz"
      sha256 "@SHA256(kuizer-aarch64-apple-darwin.tar.xz)@"
    end
    on_intel do
      url "https://github.com/remcostoeten/kuizer/releases/download/v@VERSION@/kuizer-x86_64-apple-darwin.tar.xz"
      sha256 "@SHA256(kuizer-x86_64-apple-darwin.tar.xz)@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/remcostoeten/kuizer/releases/download/v@VERSION@/kuizer-aarch64-unknown-linux-gnu.tar.xz"
      sha256 "@SHA256(kuizer-aarch64-unknown-linux-gnu.tar.xz)@"
    end
    on_intel do
      url "https://github.com/remcostoeten/kuizer/releases/download/v@VERSION@/kuizer-x86_64-unknown-linux-gnu.tar.xz"
      sha256 "@SHA256(kuizer-x86_64-unknown-linux-gnu.tar.xz)@"
    end
  end

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    bin.install "kuizer"
    # 0.1.3 and older read `kuizer generate` as a folder to scan.
    return if version <= "0.1.3"

    generate_completions_from_executable(bin/"kuizer", "generate", "completions")
    system bin/"kuizer", "generate", "man", "--out", buildpath/"man"
    man1.install buildpath.glob("man/*.1")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/kuizer --version")
  end
end
