{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"style": "warn",
		"pedantic": "warn"
	},
	"rules": {
		"func-style": "off",
		"sort-keys": "off",
		"sort-imports": "allow",
		"no-magic-numbers": "off",
		"id-length": "off",
		"curly": "off",
		"no-continue": "off",
		"prefer-destructuring": "off",
		"max-depth": "off",
		"max-statements": "off",
		"max-classes-per-file": "off",
		"eslint-plugin-unicorn/filename-case": "off",
		"eslint-plugin-unicorn/escape-case": "off",
		"eslint-plugin-unicorn/no-hex-escape": "off",
		"eslint-plugin-unicorn/prefer-string-replace-all": "off",
		"no-ternary": "off",
		"no-unsafe-call": "off",
		"no-unsafe-member-access": "off",
		"strict-boolean-expressions": "off",
		"no-unsafe-type-assertion": "off",
		"no-unsafe-assignment": "off",
		"no-unsafe-argument": "off",
		"switch-case-braces": "off",
		"no-array-sort": "off",
		"no-null": "off",
		"max-lines-per-function": "off",
		"max-lines": "off",
		"max-params": "off",
		"prefer-template": "off",
		"no-negated-condition": "off",
		"init-declarations": "off",
		"no-shadow": "off",
		"array-type": "off",
		"prefer-includes": "off",
		"require-await": "off",
		"switch-exhaustiveness-check": "off",
		"prefer-nullish-coalescing": "off",
		"capitalized-comments": "off",
		"no-confusing-void-expression": "off",
		"consistent-type-definitions": "off",
		"return-await": "off",
		"no-unnecessary-type-assertion": "off",
		"parameter-properties": "off",
		"unified-signatures": "off",
		"prefer-ternary": "off",
		"prefer-at": "off",
		"no-unnecessary-template-expression": "off",
		"no-empty-pattern": "off",
		"no-array-callback-reference": "off",
		"no-useless-undefined": "off",
		"no-template-curly-in-string": "off",
		"no-nested-ternary": "off",
		"no-unsafe-return": "off",
		"no-duplicate-imports": "off"
	},
	"options": {
		"typeAware": true
	}
}
