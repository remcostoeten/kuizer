{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"style": "warn",
		"pedantic": "warn"
	},
	"rules": {
		"func-style": "off",
		"sort-keys": "off",
		"sort-imports": "allow",
		"no-magic-numbers": "off",
		"id-length": "off",
		"curly": "off",
		"no-continue": "off",
		"prefer-destructuring": "off",
		"max-depth": "off",
		"max-statements": "off",
		"max-classes-per-file": "off",
		"eslint-plugin-unicorn/filename-case": "off",
		"eslint-plugin-unicorn/escape-case": "off",
		"eslint-plugin-unicorn/no-hex-escape": "off",
		"eslint-plugin-unicorn/prefer-string-replace-all": "off"
	},
	"options": {
		"typeAware": true
	}
}
